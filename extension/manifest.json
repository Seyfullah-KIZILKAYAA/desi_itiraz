{
  "manifest_version": 3,
  "name": "Desi İtiraz Köprüsü",
  "version": "0.1.6",
  "description": "Masaüstü uygulamasına bağlanır; itiraz akışını kaydeder ve tekrar oynatır.",
  "permissions": ["scripting", "activeTab", "tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["selectors.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Desi İtiraz Köprüsü",
    "default_popup": "popup.html"
  }
}
